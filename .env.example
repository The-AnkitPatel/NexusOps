# NexusOps environment configuration (all values are optional).
# The gateway runs fully offline with NONE of these set.

# --- Live-LLM synthesis (optional) ---
# Leave empty to run in deterministic offline mode. Set a key to enable live
# Gemini synthesis (also: pip install ".[llm]").
GEMINI_API_KEY=
NEXUS_MODEL=gemini-2.5-flash
# GenAI semantic-convention system id. "gemini" (Developer API) or "vertex_ai".
GEN_AI_SYSTEM=gemini

# --- Telemetry (optional) ---
OTEL_SERVICE_NAME=nexusops-enterprise-gateway
# Set to a collector URL to ALSO export spans over OTLP/HTTP
# (needs: pip install ".[otlp]"), e.g. http://localhost:4318/v1/traces
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=INFO

# --- Data paths ---
DATABASE_PATH=data/enterprise_tickets.db
POLICIES_PATH=data/enterprise_policies.json
